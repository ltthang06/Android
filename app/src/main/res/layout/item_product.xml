<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:theme="@style/ProductCardSurface" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:strokeWidth="1dp" app:strokeColor="#E8E3EF" app:cardBackgroundColor="#FFFFFF" android:foreground="?attr/selectableItemBackground" android:stateListAnimator="@animator/product_press">
