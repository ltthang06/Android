<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_surface" android:clipToPadding="false" android:fillViewport="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_large">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_doi_mat_khau" android:textColor="#3F3A48" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/label_nhap_mat_khau_hien_tai_va_mat_khau_moi_cua_ban" android:textColor="#686575" android:textSize="14sp" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="@string/label_mat_khau_hien_tai" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_marginTop="14dp" app:endIconMode="password_toggle" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:boxBackgroundColor="#FDFCFF" app:boxStrokeColor="@color/login_input_outline" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtOldPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:minHeight="56dp" android:singleLine="true" android:saveEnabled="false" android:imeOptions="actionNext" android:maxLength="128" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="@string/password_new_label" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_marginTop="6dp" app:endIconMode="password_toggle" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:boxBackgroundColor="#FDFCFF" app:boxStrokeColor="@color/login_input_outline" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp" app:helperText="@string/password_minimum_hint">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtNewPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:minHeight="56dp" android:singleLine="true" android:saveEnabled="false" android:imeOptions="actionNext" android:maxLength="128" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="@string/label_nhap_lai_mat_khau_moi" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_marginTop="6dp" app:endIconMode="password_toggle" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:boxBackgroundColor="#FDFCFF" app:boxStrokeColor="@color/login_input_outline" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtConfirmPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:minHeight="56dp" android:singleLine="true" android:saveEnabled="false" android:imeOptions="actionDone" android:maxLength="128" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="end" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelChangePassword" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/label_huy" style="@style/Widget.Material3.Button.TextButton" app:cornerRadius="14dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveChangePassword" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/label_doi_mat_khau" android:textSize="15sp" app:cornerRadius="14dp" app:backgroundTint="@color/login_button_background" android:insetTop="0dp" android:insetBottom="0dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
