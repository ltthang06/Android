<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_page">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:focusableInTouchMode="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:layout_marginBottom="20dp" android:background="@drawable/bg_about_banner">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:layout_marginBottom="16dp" android:src="@drawable/ic_email" android:padding="10dp" android:background="@drawable/bg_surface" android:contentDescription="@null" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auth_forgot" android:textSize="28sp" android:textColor="#FFFFFF" android:textStyle="bold" android:id="@+id/actionTitle" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auth_reset_hint" android:textSize="15sp" android:textColor="#E7E1FA" android:layout_marginTop="10dp" android:lineSpacingExtra="3dp" android:id="@+id/actionSubtitle" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_surface">
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/actionEmailBox" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/label_email" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:startIconDrawable="@drawable/ic_email" app:startIconTint="@color/brand" app:startIconContentDescription="@null">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/actionEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:singleLine="true" android:textSize="16sp" android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auth_email_note" android:textSize="14sp" android:textColor="@color/text_secondary" android:id="@+id/actionStatus" android:accessibilityLiveRegion="polite" android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/actionSend" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/auth_send_reset" app:cornerRadius="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/actionCheck" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/auth_check_verified" app:cornerRadius="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/actionBack" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/auth_back_login" app:cornerRadius="16dp" />
    </LinearLayout>
</ScrollView>
