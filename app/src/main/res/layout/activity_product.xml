<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/drawerLayout" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/page_background" android:padding="@dimen/space_medium" android:id="@+id/productRoot">
        <TextView android:id="@+id/tvWelcome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:layout_centerHorizontal="false" android:layout_marginTop="24dp" android:text="@string/label_xin_chao" android:textSize="14sp" android:textStyle="bold" android:layout_toEndOf="@id/btnMenu" android:layout_marginStart="12dp" android:textColor="#6C5F7C" android:layout_toStartOf="@id/btnProfile" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tvTitle" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/tvWelcome" android:layout_centerHorizontal="false" android:layout_marginTop="20dp" android:text="@string/label_kham_pha_cong_nghe" android:textSize="24sp" android:textStyle="bold" android:layout_marginStart="12dp" android:textColor="#30203F" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/listView" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/btnMenu" android:layout_above="@id/tabBar" android:layout_marginTop="8dp" android:clipToPadding="false" android:paddingBottom="16dp" android:scrollbars="none" android:paddingTop="2dp" />
        <LinearLayout android:id="@+id/cartTabContent" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/tvTitle" android:layout_above="@id/tabBar" android:layout_marginTop="12dp" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:id="@+id/cartSelectionBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <com.google.android.material.checkbox.MaterialCheckBox style="@style/CartSelectionCheckbox" android:id="@+id/cartSelectAll" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/cart_select_all" android:textSize="14sp" android:textColor="@color/text_primary" android:paddingStart="8dp" android:paddingEnd="8dp"/>
                <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton" android:id="@+id/btnClearCart" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/label_xoa_tat_ca" android:textColor="#B3261E" />
            </LinearLayout>
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <LinearLayout android:id="@+id/cartTabItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </ScrollView>
            <LinearLayout android:id="@+id/cartSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_surface" android:orientation="vertical" android:padding="@dimen/space_medium">
                <TextView android:id="@+id/tvCartTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/label_tong_cong_0d" android:textColor="@color/brand" android:textSize="19sp" android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCheckout" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="12dp" android:text="@string/label_tiep_tuc_dat_hang" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/tabBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:background="@drawable/bg_navigation" android:elevation="1dp" android:layout_marginTop="12dp" app:itemIconTint="@color/navigation_item" app:itemTextColor="@color/navigation_item" app:menu="@menu/bottom_navigation" app:labelVisibilityMode="labeled" app:itemIconSize="24dp" app:itemHorizontalTranslationEnabled="false" android:minHeight="64dp" app:itemPaddingTop="8dp" app:itemPaddingBottom="8dp" android:paddingTop="0dp" android:paddingBottom="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMenu" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentStart="true" android:layout_alignParentTop="true" android:layout_marginTop="12dp" android:background="@android:color/transparent" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="@string/label_activity_product_text" android:textColor="#4A4453" android:textSize="32sp" android:visibility="visible" />
        <ImageButton android:id="@+id/btnProfile" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentTop="true" android:layout_alignParentEnd="true" android:layout_marginTop="12dp" android:background="@android:color/transparent" android:contentDescription="@string/label_ho_so_ca_nhan" android:padding="10dp" android:src="@drawable/ic_profile" />
        <ScrollView android:id="@+id/extraTabContent" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/tvTitle" android:layout_above="@id/tabBar" android:visibility="gone" android:layout_marginTop="16dp">
            <LinearLayout android:id="@+id/extraTabItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </RelativeLayout>
    <LinearLayout android:id="@+id/leftMenu" android:layout_width="300dp" android:layout_height="match_parent" android:layout_gravity="start" android:background="#FAF9FD" android:orientation="vertical" android:fitsSystemWindows="true" android:paddingStart="16dp" android:paddingEnd="16dp">
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <FrameLayout android:id="@+id/drawerProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:background="@drawable/bg_about_banner" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
                    <ImageView android:layout_width="160dp" android:layout_height="160dp" android:layout_gravity="top|end" android:layout_marginTop="-60dp" android:layout_marginEnd="-45dp" android:src="@drawable/login_orbits" android:importantForAccessibility="no" android:contentDescription="@null" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp">
                        <TextView android:id="@+id/drawerAvatar" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_avatar" android:gravity="center" android:textColor="@color/brand" android:textSize="22sp" android:textStyle="bold" android:importantForAccessibility="no" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/drawerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="21sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" />
                            <TextView android:id="@+id/drawerEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="#E8DFF6" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginBottom="12dp" android:text="@string/drawer_manage" android:textColor="@color/text_secondary" android:textSize="11sp" android:letterSpacing="0.08" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="6dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMenuAccount" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="start|center_vertical" android:text="@string/personal_information" android:textSize="15sp" android:textColor="@color/text_primary" app:icon="@drawable/nav_account" app:iconTint="@color/brand" app:iconPadding="12dp" app:cornerRadius="14dp" android:paddingStart="16dp" android:paddingEnd="40dp" android:insetTop="0dp" android:insetBottom="0dp" android:maxLines="1" android:ellipsize="end" app:iconSize="22dp" app:backgroundTint="@color/drawer_item_background" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="14dp" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" android:contentDescription="@null" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="6dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnOrders" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="start|center_vertical" android:text="@string/purchase_history" android:textSize="15sp" android:textColor="@color/text_primary" app:icon="@drawable/nav_cart" app:iconTint="@color/brand" app:iconPadding="12dp" app:cornerRadius="14dp" android:paddingStart="16dp" android:paddingEnd="40dp" android:insetTop="0dp" android:insetBottom="0dp" android:maxLines="1" android:ellipsize="end" app:iconSize="22dp" app:backgroundTint="@color/drawer_item_background" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="14dp" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" android:contentDescription="@null" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="6dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMenuChangePassword" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="start|center_vertical" android:text="@string/label_doi_mat_khau" android:textSize="15sp" android:textColor="@color/text_primary" app:icon="@drawable/ic_security" app:iconTint="@color/brand" app:iconPadding="12dp" app:cornerRadius="14dp" android:paddingStart="16dp" android:paddingEnd="40dp" android:insetTop="0dp" android:insetBottom="0dp" android:maxLines="1" android:ellipsize="end" app:iconSize="22dp" app:backgroundTint="@color/drawer_item_background" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="14dp" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" android:contentDescription="@null" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="6dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMenuAbout" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="start|center_vertical" android:text="@string/label_gioi_thieu" android:textSize="15sp" android:textColor="@color/text_primary" app:icon="@drawable/nav_about" app:iconTint="@color/brand" app:iconPadding="12dp" app:cornerRadius="14dp" android:paddingStart="16dp" android:paddingEnd="40dp" android:insetTop="0dp" android:insetBottom="0dp" android:maxLines="1" android:ellipsize="end" app:iconSize="22dp" app:backgroundTint="@color/drawer_item_background" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="14dp" android:src="@drawable/ic_chevron_right" android:importantForAccessibility="no" android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>
        </ScrollView>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:background="@color/outline_soft" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMenuLogout" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="0dp" android:gravity="start|center_vertical" android:paddingHorizontal="16dp" android:text="@string/label_dang_xuat" android:textSize="15sp" android:textColor="#B3261E" app:icon="@drawable/ic_logout" app:iconTint="#B3261E" app:iconPadding="12dp" app:cornerRadius="16dp" android:insetTop="0dp" android:insetBottom="0dp" app:iconSize="22dp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
