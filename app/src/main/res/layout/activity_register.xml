<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_page" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:focusableInTouchMode="true">
        <FrameLayout android:id="@+id/registerBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:background="@drawable/bg_about_banner">
            <ImageView android:layout_width="180dp" android:layout_height="180dp" android:layout_gravity="top|end" android:layout_marginTop="-46dp" android:layout_marginEnd="-42dp" android:src="@drawable/login_orbits" android:contentDescription="@null" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="12dp" android:src="@drawable/images" android:padding="9dp" android:background="@drawable/bg_surface" android:contentDescription="@string/label_bieu_tuong_ung_dung" android:elevation="2dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auth_create" android:textSize="26sp" android:textColor="#FFFFFF" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auth_register_hint" android:textSize="14sp" android:textColor="#DBD4EE" android:layout_marginTop="8dp" android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_surface">
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/edtRegUsernameBox" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/label_ten_dang_nhap" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:startIconDrawable="@drawable/nav_account" app:startIconTint="@color/brand" app:startIconContentDescription="@null" app:boxBackgroundColor="#FDFCFF" app:boxStrokeColor="@color/login_input_outline" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtRegUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:singleLine="true" android:textSize="16sp" android:inputType="text" android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/edtRegEmailBox" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/label_email" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:startIconDrawable="@drawable/ic_email" app:startIconTint="@color/brand" app:startIconContentDescription="@null" app:boxBackgroundColor="#FDFCFF" app:boxStrokeColor="@color/login_input_outline" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtRegEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:singleLine="true" android:textSize="16sp" android:inputType="textEmailAddress" android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/edtRegPhoneBox" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/label_so_dien_thoai" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:startIconDrawable="@drawable/ic_phone" app:startIconTint="@color/brand" app:startIconContentDescription="@null" app:boxBackgroundColor="#FDFCFF" app:boxStrokeColor="@color/login_input_outline" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtRegPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:singleLine="true" android:textSize="16sp" android:inputType="phone" android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/edtRegPasswordBox" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/auth_password_hint" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:endIconMode="password_toggle" app:boxBackgroundColor="#FDFCFF" app:boxStrokeColor="@color/login_input_outline" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtRegPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:singleLine="true" android:textSize="16sp" android:inputType="textPassword" android:saveEnabled="false" android:maxLength="128" android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/edtRegConfirmBox" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:hint="@string/label_nhap_lai_mat_khau" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:endIconMode="password_toggle" app:boxBackgroundColor="#FDFCFF" app:boxStrokeColor="@color/login_input_outline" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtRegConfirm" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:singleLine="true" android:textSize="16sp" android:inputType="textPassword" android:saveEnabled="false" android:maxLength="128" android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/auth_create" app:cornerRadius="16dp" android:insetTop="0dp" android:insetBottom="0dp" android:textSize="16sp" android:textStyle="bold" app:backgroundTint="@color/login_button_background" app:rippleColor="#24FFFFFF" android:stateListAnimator="@animator/product_press" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auth_signin_prompt" android:textSize="14sp" android:textColor="@color/text_secondary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBackLogin" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/label_dang_nhap" app:cornerRadius="16dp" android:textSize="14sp" android:textStyle="bold" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
