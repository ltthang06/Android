<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="0dp">
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.TextButton"
        android:id="@+id/btnBackToProducts"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:text="@string/label_quay_lai"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
                <ImageView
                    android:id="@+id/ivDetailImage" android:layout_width="match_parent" android:layout_height="250dp"
                    android:background="@drawable/bg_detail_photo" android:padding="24dp"
                    android:scaleType="fitCenter" android:contentDescription="@string/label_anh_san_pham"/>
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.TextButton"
                android:id="@+id/btnFavorite" android:layout_width="wrap_content" android:layout_height="48dp"
                android:layout_gravity="end" android:text="@string/favorite_action"
                android:textSize="14sp" android:textStyle="bold"
                app:icon="@drawable/ic_favorite" app:iconTint="@null"/>
            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
            <TextView
                android:id="@+id/tvDetailPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/brand"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_thong_tin_san_pham"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#392357"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:id="@+id/specificationTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface"
                android:padding="20dp"/>
            <LinearLayout android:id="@+id/reviewSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView
                android:id="@+id/tvRelatedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_san_pham_khac"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#392357"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false">
                <LinearLayout
                    android:id="@+id/relatedProducts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/bg_surface">
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:id="@+id/btnAddToCart"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="8dp"
            android:text="@string/label_them_vao_gio"
            app:cornerRadius="16dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuyNow"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/button_height"
            android:text="@string/label_mua_ngay"
            app:cornerRadius="16dp"/>
    </LinearLayout>
</LinearLayout>
