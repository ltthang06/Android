<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
 android:layout_marginTop="20dp" android:padding="24dp" android:gravity="center_horizontal" android:background="@drawable/bg_surface">
 <ImageView android:layout_width="80dp" android:layout_height="80dp" android:padding="22dp"
 android:src="@drawable/ic_favorite" android:background="@drawable/bg_product_image"
 android:contentDescription="@null" android:importantForAccessibility="no"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
 android:text="@string/favorites_empty_title" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
 android:text="@string/favorites_empty_hint" android:textSize="15sp" android:textColor="@color/text_secondary" android:gravity="center" android:lineSpacingExtra="3dp"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/btnFavoriteBrowse"
 android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="20dp"
 android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="16dp"
 android:text="@string/favorites_explore"/>
</LinearLayout>