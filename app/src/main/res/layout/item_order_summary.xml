<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_surface"
    android:foreground="?attr/selectableItemBackground">
    <TextView
        android:id="@+id/orderStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_price_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:textColor="#56338B"
        android:textSize="13sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/orderCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="20sp"/>
    <TextView
        android:id="@+id/orderCardMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"/>
    <LinearLayout
        android:id="@+id/orderCardThumbnails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:visibility="gone"/>
    <TextView
        android:id="@+id/orderCardItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:lineSpacingExtra="5dp"/>
    <View
        android:id="@+id/orderCardDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/outline_soft"/>
    <TextView
        android:id="@+id/orderCardTotalLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/order_total_label"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />
    <TextView
        android:id="@+id/orderCardTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/brand"
        android:textStyle="bold"
        android:textSize="21sp"/>
    <TextView
        android:id="@+id/orderCardAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/brand"
        android:textSize="14sp"
        android:textStyle="bold"/>
</LinearLayout>
