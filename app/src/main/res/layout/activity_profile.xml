<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_page" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:focusableInTouchMode="true">
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton" android:id="@+id/btnProfileBack" android:layout_width="wrap_content" android:layout_height="48dp" app:cornerRadius="16dp" android:text="@string/label_quay_lai" android:textSize="15sp" android:layout_marginBottom="12dp" />
        <FrameLayout android:id="@+id/profileBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:background="@drawable/bg_about_banner">
            <ImageView android:layout_width="180dp" android:layout_height="180dp" android:layout_gravity="top|end" android:layout_marginTop="-46dp" android:layout_marginEnd="-42dp" android:src="@drawable/login_orbits" android:contentDescription="@null" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="12dp" android:src="@drawable/ic_profile" android:padding="9dp" android:background="@drawable/bg_surface" android:contentDescription="@string/label_bieu_tuong_ung_dung" android:elevation="2dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_ho_so_ca_nhan" android:textSize="26sp" android:textColor="#FFFFFF" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_quan_ly_tai_khoan_va_thong_tin_lien_he" android:textSize="14sp" android:textColor="#DBD4EE" android:layout_marginTop="8dp" android:layout_marginBottom="0dp" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_surface" android:padding="20dp">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/label_ten_dang_nhap" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:startIconDrawable="@drawable/nav_account" app:startIconTint="@color/brand" app:startIconContentDescription="@null" app:boxBackgroundColor="#FDFCFF" app:boxStrokeColor="@color/login_input_outline" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtProfileUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:singleLine="true" android:textSize="16sp" android:inputType="text" android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:hint="@string/auth_email_fixed" app:helperText="@string/auth_email_profile_hint" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:startIconDrawable="@drawable/ic_email" app:startIconTint="@color/brand" app:startIconContentDescription="@null" app:boxBackgroundColor="#F8F6FC" app:boxStrokeColor="@color/login_input_outline" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtProfileEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:singleLine="true" android:textSize="16sp" android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/bg_verified_status" android:text="@string/profile_verified" android:textSize="12sp" android:textStyle="bold" android:textColor="#216E52" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:hint="@string/label_so_dien_thoai" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:startIconDrawable="@drawable/ic_phone" app:startIconTint="@color/brand" app:startIconContentDescription="@null" app:boxBackgroundColor="#FDFCFF" app:boxStrokeColor="@color/login_input_outline" app:boxStrokeWidth="1dp" app:boxStrokeWidthFocused="2dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtProfilePhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:singleLine="true" android:textSize="16sp" android:inputType="phone" android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnProfileUpdate" android:layout_width="match_parent" android:layout_height="56dp" app:cornerRadius="16dp" android:text="@string/label_luu_thay_doi" android:textSize="16sp" android:insetTop="0dp" android:insetBottom="0dp" android:textStyle="bold" app:backgroundTint="@color/login_button_background" app:rippleColor="#24FFFFFF" android:stateListAnimator="@animator/product_press" android:enabled="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
